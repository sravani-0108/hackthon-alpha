# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api
# Use * when sharing via ngrok, or list localhost + your ngrok URL
CORS_ORIGIN=*

# Database (use DATABASE_URL or individual vars)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aml_system
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=aml_system
# DB_USER=postgres
# DB_PASSWORD=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# AML
HIGH_RISK_COUNTRIES=Iran,North Korea,Syria,Afghanistan,Yemen

# Google ADK / Gemini (required for LLM agents)
GEMINI_API_KEY=your_gemini_api_key
# Legacy alias also supported:
# GOOGLE_API_KEY=your_gemini_api_key

# Use mock screening data instead of OpenSanctions / Google Search
USE_MOCK_SCREENING=false
